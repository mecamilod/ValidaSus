<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador SIGTAP - Componente Inicial</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="main-header">
        <div class="header-container">
            <h1>Simulador SIGTAP</h1>
            <span class="badge-competencia">Competência: 06/2026</span>
        </div>
    </header>

    <main class="simulador-container">
        <!-- Seção de Filtros e Busca -->
        <section class="busca-section">
            <div class="search-group">
                <input type="text" id="input-busca" placeholder="Busque por código, nome do procedimento ou CID...">
                <button id="btn-buscar" class="btn-primary">Buscar</button>
            </div>
            
            <div class="filter-group">
                <label for="filtro-deficiencia">Classe de Deficiência:</label>
                <select id="filtro-deficiencia">
                    <option value="todos">Todos os Procedimentos</option>
                    <option value="Não se Aplica">Não se Aplica (PICS / Geral)</option>
                    <option value="Física">Deficiência Física</option>
                    <option value="Visual">Deficiência Visual</option>
                </select>
            </div>
        </section>

        <!-- Grade Dinâmica de Resultados -->
        <section class="resultados-section">
            <div class="resultados-header">
                <h2>Procedimentos Mapeados</h2>
                <span id="contador-resultados">Carregando procedimentos...</span>
            </div>
            
            <div id="grid-dinamico-procedimentos" class="grid-procedimentos">
                <!-- Os cards de procedimentos serão injetados aqui pelo JavaScript -->
            </div>
        </section>
    </main>

    <script src="app.js"></script>
</body>
</html>
