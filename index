<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ValidaSUS - Instituto Tech Reabilitar</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="app-header">
        <div class="header-container">
            <div class="brand">
                <h1>ValidaSUS</h1>
                <p>by Tech Reabilitar</p>
            </div>
            <div class="meta">
                <span class="badge-competencia">Competência v06/2026</span>
            </div>
        </div>
    </header>

    <main class="app-container">
        <section class="filter-panel">
            <h2>Filtros de Auditoria e Compatibilidade</h2>
            <div class="filter-grid">
                <div class="filter-control">
                    <label for="select-classe">Classe (Tipo de Deficiência/Atuação):</label>
                    <select id="select-classe">
                        <option value="todos">-- Todas as Classes --</option>
                    </select>
                </div>

                <div class="filter-control">
                    <label for="select-forma">Forma de Organização:</label>
                    <select id="select-forma" disabled>
                        <option value="todos">-- Selecione uma classe primeiro --</option>
                    </select>
                </div>
            </div>

            <div class="search-bar-container">
                <label for="search-input">Busca Rápida Cruzada (Código, Nome, CID ou CBO):</label>
                <input type="text" id="search-input" placeholder="Digite o código do procedimento, CBO, ou um CID específico (Ex: G800)...">
            </div>
        </section>

        <section class="results-panel">
            <div class="results-header">
                <h3>Procedimentos Homologados</h3>
                <span id="counter-procedimentos">Listando 0 procedimentos</span>
            </div>

            <div id="grid-procedimentos" class="procedimentos-grid">
                </div>
        </section>
    </main>

    <script src="base_sigtap.js"></script>
    <script src="app.js"></script>
</body>
</html>
